<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Common" oor:package="org.openoffice.Office">
  <node oor:name="Misc">
    <prop oor:name="ShowTipOfTheDay" oor:op="replace"><value>false</value></prop>
    <prop oor:name="ShowDonation" oor:op="replace"><value>false</value></prop>
  </node>
  <node oor:name="Appearance">
    <!-- turn on Vino's program colours (VinoTheme.xcu) -->
    <prop oor:name="LibreOfficeTheme" oor:op="replace"><value>1</value></prop>
  </node>
  <node oor:name="Help">
    <node oor:name="StartCenter">
      <!-- Start Center middle area: Vino navy (matches the logo tile) with soft white text, in light and dark theme -->
      <prop oor:name="StartCenterThumbnailsBackgroundColor" oor:op="replace"><value>727594</value></prop>
      <prop oor:name="StartCenterThumbnailsTextColor" oor:op="replace"><value>15134453</value></prop>
    </node>
  </node>
</oor:component-data>
