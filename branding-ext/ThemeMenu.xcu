<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="com.vinosoffice.theme" oor:op="replace">
        <node oor:name="S1" oor:op="replace">
          <prop oor:name="MergePoint"><value>.uno:ViewMenu\.uno:FullScreen</value></prop>
          <prop oor:name="MergeCommand"><value>AddAfter</value></prop>
          <prop oor:name="MergeFallback"><value>AddPath</value></prop>
          <prop oor:name="MergeContext"><value></value></prop>
          <node oor:name="MenuItems">
            <node oor:name="M0" oor:op="replace">
              <prop oor:name="URL"><value>private:separator</value></prop>
            </node>
            <node oor:name="M1" oor:op="replace">
              <prop oor:name="URL"><value></value></prop>
              <prop oor:name="Title"><value xml:lang="en-US">Vino's Office ~Theme</value><value xml:lang="zh-CN">Vino's Office 主题(~T)</value><value xml:lang="zh-TW">Vino's Office 佈景主題(~T)</value></prop>
              <node oor:name="Submenu">
                <node oor:name="T1" oor:op="replace">
                  <prop oor:name="URL"><value>com.vinosoffice.theme:Light</value></prop>
                  <prop oor:name="Title"><value xml:lang="en-US">~Light</value><value xml:lang="zh-CN">浅色(~L)</value><value xml:lang="zh-TW">淺色(~L)</value></prop>
                  <prop oor:name="Target"><value>_self</value></prop>
                </node>
                <node oor:name="T2" oor:op="replace">
                  <prop oor:name="URL"><value>com.vinosoffice.theme:Dark</value></prop>
                  <prop oor:name="Title"><value xml:lang="en-US">~Dark</value><value xml:lang="zh-CN">深色(~D)</value><value xml:lang="zh-TW">深色(~D)</value></prop>
                  <prop oor:name="Target"><value>_self</value></prop>
                </node>
                <node oor:name="T3" oor:op="replace">
                  <prop oor:name="URL"><value>com.vinosoffice.theme:Auto</value></prop>
                  <prop oor:name="Title"><value xml:lang="en-US">~Same as Windows</value><value xml:lang="zh-CN">跟随 Windows(~S)</value><value xml:lang="zh-TW">跟隨 Windows(~S)</value></prop>
                  <prop oor:name="Target"><value>_self</value></prop>
                </node>
              </node>
            </node>
          </node>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
