<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Jobs" oor:package="org.openoffice.Office">
  <node oor:name="Jobs">
    <node oor:name="VinosThemeWatcher" oor:op="replace">
      <prop oor:name="Service"><value>com.vinosoffice.ThemeWatcher</value></prop>
    </node>
    <node oor:name="VinosRibbon" oor:op="replace">
      <prop oor:name="Service"><value>com.vinosoffice.RibbonJob</value></prop>
    </node>
  </node>
  <node oor:name="Events">
    <node oor:name="OnStartApp" oor:op="fuse">
      <node oor:name="JobList"><node oor:name="VinosThemeWatcher" oor:op="replace"/></node>
    </node>
    <node oor:name="OnViewCreated" oor:op="fuse">
      <node oor:name="JobList"><node oor:name="VinosThemeWatcher" oor:op="replace"/><node oor:name="VinosRibbon" oor:op="replace"/></node>
    </node>
  </node>
</oor:component-data>
