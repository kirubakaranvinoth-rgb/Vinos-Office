<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">
    <node oor:name="OfficeMenuBarMerging">
      <node oor:name="org.celllite.sheetshome" oor:op="replace">
        <node oor:name="S1" oor:op="replace">
          <prop oor:name="MergePoint"><value>.uno:SheetMenu\.uno:InsertCell</value></prop>
          <prop oor:name="MergeCommand"><value>AddBefore</value></prop>
          <prop oor:name="MergeFallback"><value>AddPath</value></prop>
          <prop oor:name="MergeContext"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <node oor:name="MenuItems">
            <node oor:name="M1" oor:op="replace">
              <prop oor:name="URL"><value>org.celllite.sheetshome:Home</value></prop>
              <prop oor:name="Title"><value xml:lang="en-US">Sheets ~Home...</value><value xml:lang="zh-CN">工作表主页(~H)...</value><value xml:lang="zh-TW">工作表首頁(~H)...</value></prop>
              <prop oor:name="Target"><value>_self</value></prop>
            </node>
            <node oor:name="M2" oor:op="replace">
              <prop oor:name="URL"><value>org.celllite.sheetshome:Index</value></prop>
              <prop oor:name="Title"><value xml:lang="en-US">Create Contents Inde~x Sheet</value><value xml:lang="zh-CN">创建目录索引工作表(~X)</value><value xml:lang="zh-TW">建立目錄索引工作表(~X)</value></prop>
              <prop oor:name="Target"><value>_self</value></prop>
            </node>
            <node oor:name="M3" oor:op="replace">
              <prop oor:name="URL"><value>private:separator</value></prop>
            </node>
          </node>
        </node>
      </node>
    </node>
    <node oor:name="OfficeToolBar">
      <node oor:name="org.celllite.sheetshome" oor:op="replace">
        <node oor:name="T1" oor:op="replace">
          <prop oor:name="URL"><value>org.celllite.sheetshome:Home</value></prop>
          <prop oor:name="Title"><value xml:lang="en-US">Sheets Home (Ctrl+Shift+H)</value><value xml:lang="zh-CN">工作表主页 (Ctrl+Shift+H)</value><value xml:lang="zh-TW">工作表首頁 (Ctrl+Shift+H)</value></prop>
          <prop oor:name="Target"><value>_self</value></prop>
          <prop oor:name="Context"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
        </node>
      </node>
    </node>
    <!-- Ribbon (Tabbed layout): Extension tab, Calc only -->
    <node oor:name="OfficeNotebookBar">
      <node oor:name="org.celllite.sheetshome" oor:op="replace">
        <node oor:name="N1" oor:op="replace">
          <prop oor:name="URL"><value>org.celllite.sheetshome:Home</value></prop>
          <prop oor:name="Title"><value xml:lang="en-US">Sheets Home</value><value xml:lang="zh-CN">工作表主页</value><value xml:lang="zh-TW">工作表首頁</value></prop>
          <prop oor:name="Target"><value>_self</value></prop>
          <prop oor:name="Context"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="ControlType"><value>ImageButton</value></prop>
          <prop oor:name="Width"><value>0</value></prop>
          <prop oor:name="Style"><value>Icon+Text</value></prop>
        </node>
        <node oor:name="N2" oor:op="replace">
          <prop oor:name="URL"><value>org.celllite.sheetshome:Index</value></prop>
          <prop oor:name="Title"><value xml:lang="en-US">Contents Sheet</value><value xml:lang="zh-CN">目录工作表</value><value xml:lang="zh-TW">目錄工作表</value></prop>
          <prop oor:name="Target"><value>_self</value></prop>
          <prop oor:name="Context"><value>com.sun.star.sheet.SpreadsheetDocument</value></prop>
          <prop oor:name="ControlType"><value>ImageButton</value></prop>
          <prop oor:name="Width"><value>0</value></prop>
          <prop oor:name="Style"><value>Icon+Text</value></prop>
        </node>
      </node>
    </node>
    <node oor:name="Images">
      <node oor:name="org.celllite.sheetshome.home" oor:op="replace">
        <prop oor:name="URL"><value>org.celllite.sheetshome:Home</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL"><value>%origin%/icons/home_16.png</value></prop>
          <prop oor:name="ImageBigURL"><value>%origin%/icons/home_26.png</value></prop>
        </node>
      </node>
      <node oor:name="org.celllite.sheetshome.index" oor:op="replace">
        <prop oor:name="URL"><value>org.celllite.sheetshome:Index</value></prop>
        <node oor:name="UserDefinedImages">
          <prop oor:name="ImageSmallURL"><value>%origin%/icons/index_16.png</value></prop>
          <prop oor:name="ImageBigURL"><value>%origin%/icons/index_26.png</value></prop>
        </node>
      </node>
    </node>
  </node>
</oor:component-data>
